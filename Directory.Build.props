<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>false</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <Version>0.1.0</Version>
    <Authors>Zapret2_AutoTuner contributors</Authors>
    <Product>Zapret2 AutoTuner</Product>
    <Copyright>MIT</Copyright>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>ru;en</SatelliteResourceLanguages>
    <!-- CA1515/CA1848 etc. are noise for an application; keep the useful analyzers. -->
    <NoWarn>$(NoWarn);CA1515;CA1848;CA1716;CA1031;CA1062;CA1303;CA1305;CA1307;CA1309;CA1310;CA1311;CA1304;CA1819;CA1002;CA1024;CA1034;CA1054;CA1055;CA1056;CA1707;CA1711;CA1720;CA1725;CA1812;CA1822;CA1859;CA1860;CA1861;CA1865;CA1866;CA1869;CA2000;CA2007;CA2227;CA5394;CA5350;CA5351;CA1308;CA1806;CA1032;CA1064;CA1027;CA1028;CA1008;CA1051;CA1063;CA1816;CA2201;CA1001;CA1849;CA1850;CA1851;CA1852;CA1854;CA1847;CA1846;CA1845;CA1863;CA1862;CA1867;CA1868;CA1870;CA1871;CA1872;CA2016;CA2234;CA2208;CA1823;CA1801;CA1508;CA2263;CA1068</NoWarn>
  </PropertyGroup>
</Project>
