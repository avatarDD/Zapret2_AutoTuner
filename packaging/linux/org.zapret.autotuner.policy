<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- The UI starts the privileged Agent through pkexec (AGENTS.md rule 6): the engine, nft rules and capture. -->
<policyconfig>
  <action id="org.zapret.autotuner.agent">
    <description>Run the Zapret2 AutoTuner agent</description>
    <description xml:lang="ru">Запуск агента Zapret2 AutoTuner</description>
    <message>Zapret2 AutoTuner needs administrator rights to run nfqws2 and set firewall rules</message>
    <message xml:lang="ru">Zapret2 AutoTuner нужны права администратора, чтобы запускать nfqws2 и правила firewall</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/opt/zapret-autotuner/ztuner-agent</annotate>
  </action>
</policyconfig>
