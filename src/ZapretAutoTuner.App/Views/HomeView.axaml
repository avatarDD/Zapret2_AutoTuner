<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ZapretAutoTuner.App.ViewModels"
             xmlns:l="using:ZapretAutoTuner.App.Loc"
             x:Class="ZapretAutoTuner.App.Views.HomeView"
             x:DataType="vm:HomeViewModel">
  <DockPanel>
    <StackPanel DockPanel.Dock="Top" Spacing="10">
      <TextBlock Classes="h1" Text="{l:T home.title}" />
      <TextBlock Classes="muted" Text="{l:T home.subtitle}" />
      <WrapPanel Margin="0,8">
        <Button Classes="accent" Padding="24,12" FontSize="16" Margin="0,0,8,8" Command="{Binding CheckCommand}">
          <Panel>
            <TextBlock Text="{l:T home.check}" IsVisible="{Binding !Running}" />
            <TextBlock Text="{l:T common.stop}" IsVisible="{Binding Running}" />
          </Panel>
        </Button>
        <Button Padding="24,12" FontSize="16" Margin="0,0,8,8" Content="{l:T home.tune}" Command="{Binding OpenWizardCommand}" />
        <Button Padding="16,12" Margin="0,0,8,8" Content="{l:T home.tune_blocked}" Command="{Binding TuneBlockedCommand}" IsVisible="{Binding !!Rows.Count}" />
      </WrapPanel>
      <StackPanel Orientation="Horizontal" Spacing="8">
        <ProgressBar IsIndeterminate="True" Width="120" IsVisible="{Binding Running}" />
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" />
      </StackPanel>
    </StackPanel>
    <Border DockPanel.Dock="Top" Classes="card" Margin="0,12,0,0" IsVisible="{Binding !Rows.Count}">
      <StackPanel Spacing="6">
        <TextBlock Text="{l:T home.how_title}" FontWeight="SemiBold" />
        <TextBlock Text="{l:T home.how_1}" TextWrapping="Wrap" />
        <TextBlock Text="{l:T home.how_2}" TextWrapping="Wrap" />
        <TextBlock Text="{l:T home.how_3}" TextWrapping="Wrap" />
        <TextBlock Text="{l:T home.how_more}" Classes="muted" TextWrapping="Wrap" Margin="0,4,0,0" />
      </StackPanel>
    </Border>
    <ScrollViewer Margin="0,12,0,0">
      <ItemsControl ItemsSource="{Binding Rows}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:CheckerRowViewModel">
            <Border Classes="card" Margin="0,0,0,6">
              <Grid ColumnDefinitions="Auto,200,*,Auto">
                <Ellipse Width="14" Height="14" Fill="{Binding LightBrush}" VerticalAlignment="Center" Margin="0,0,10,0" />
                <TextBlock Grid.Column="1" Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="{Binding Summary}" TextWrapping="Wrap" VerticalAlignment="Center" />
                <Button Grid.Column="3" Content="{l:T home.tune_one}" Margin="8,0,0,0"
                        Command="{Binding $parent[ItemsControl].((vm:HomeViewModel)DataContext).TuneCommand}" CommandParameter="{Binding}" />
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
