<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>ZapretAutoTuner.App</RootNamespace>
    <AssemblyName>ZapretAutoTuner</AssemblyName>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Loc\strings.json" LogicalName="ZapretAutoTuner.App.strings.json" />
    <InternalsVisibleTo Include="ZapretAutoTuner.App.Tests" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\ZapretAutoTuner.Core\ZapretAutoTuner.Core.csproj" />
    <ProjectReference Include="..\ZapretAutoTuner.Tools\ZapretAutoTuner.Tools.csproj" />
    <ProjectReference Include="..\ZapretAutoTuner.Probes\ZapretAutoTuner.Probes.csproj" />
    <ProjectReference Include="..\ZapretAutoTuner.Tuning\ZapretAutoTuner.Tuning.csproj" />
    <ProjectReference Include="..\ZapretAutoTuner.Delivery\ZapretAutoTuner.Delivery.csproj" />
    <ProjectReference Include="..\ZapretAutoTuner.Storage\ZapretAutoTuner.Storage.csproj" />
    <ProjectReference Include="..\ZapretAutoTuner.Protocol\ZapretAutoTuner.Protocol.csproj" />
  </ItemGroup>
  <!-- The engine bundle produced by tools/bundle is shipped as <app>/zapret2 -->
  <ItemGroup Condition="'$(RuntimeIdentifier)' != ''">
    <None Include="$(MSBuildThisFileDirectory)..\..\runtimes\$(RuntimeIdentifier)\zapret2\**\*" Link="zapret2\%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
