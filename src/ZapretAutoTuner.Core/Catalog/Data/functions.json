    { "name": "pass", "file": "zapret-lib.lua", "blocks": [], "args": [], "category": "debug", "ru": "Ничего не делать", "en": "Do nothing" },
    { "name": "pktdebug", "file": "zapret-lib.lua", "blocks": [], "args": [], "category": "debug", "ru": "Вывести пакет в лог", "en": "Log the packet" },
    { "name": "argdebug", "file": "zapret-lib.lua", "blocks": [], "args": [], "category": "debug", "ru": "Вывести аргументы в лог", "en": "Log the arguments" },
    { "name": "posdebug", "file": "zapret-lib.lua", "blocks": [], "args": [], "category": "debug", "ru": "Показать, куда попали маркеры", "en": "Show where markers resolve" },
    { "name": "detect_payload_str", "file": "zapret-lib.lua", "blocks": [],
      "args": [ { "name": "pattern", "kind": "string", "required": true }, { "name": "payload", "kind": "string" }, { "name": "undetected", "kind": "string" } ],
      "category": "debug", "ru": "Определить пейлоад по подстроке", "en": "Detect payload by substring" },

