    { "name": "stopif", "file": "zapret-auto.lua", "blocks": [],
      "args": [ { "name": "iff", "kind": "iff", "required": true }, { "name": "neg", "kind": "flag" },
                { "name": "percent", "kind": "int", "min": 0, "max": 100 }, { "name": "pattern", "kind": "string" }, { "name": "cond_code", "kind": "lua_code" } ],
      "category": "orchestrator", "orchestrator": true, "ru": "Остановить план при условии", "en": "Stop the plan if a condition holds" },
    { "name": "repeater", "file": "zapret-auto.lua", "blocks": [],
      "args": [ { "name": "instances", "kind": "int", "min": 1, "default": "1" }, { "name": "repeats", "kind": "int", "min": 1, "required": true },
