        { "name": "seqovl_pattern", "kind": "blob" },
        { "name": "blob", "kind": "blob" },
        { "name": "optional", "kind": "flag" }
      ],
      "category": "split", "ru": "Отправить кусок данных (нужен drop следом)", "en": "Send a piece of data (needs drop after)" },
    { "name": "oob", "file": "zapret-antidpi.lua", "blocks": ["fooling", "ip_id", "rawsend", "reconstruct", "ipfrag"],
