      "args": [
        { "name": "pos", "kind": "marker_list", "default": "2" },
        { "name": "seqovl", "kind": "marker" },
        { "name": "seqovl_pattern", "kind": "blob" },
        { "name": "blob", "kind": "blob" },
        { "name": "optional", "kind": "flag" },
        { "name": "nodrop", "kind": "flag" }
      ],
      "category": "split", "ru": "Сегменты в обратном порядке (не работает с Windows-серверами)", "en": "Segments in reverse order (not with Windows servers)" },
    { "name": "multidisorder_legacy", "file": "zapret-antidpi.lua", "blocks": ["direction", "payload", "fooling", "ip_id", "rawsend", "reconstruct", "ipfrag"],
      "args": [
        { "name": "pos", "kind": "marker_list", "default": "2" },
        { "name": "seqovl", "kind": "marker" },
        { "name": "seqovl_pattern", "kind": "blob" },
        { "name": "optional", "kind": "flag" }
      ],
      "category": "split", "ru": "multidisorder как в nfqws1", "en": "nfqws1-style multidisorder" },
