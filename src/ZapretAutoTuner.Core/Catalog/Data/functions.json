    { "name": "fakedsplit", "file": "zapret-antidpi.lua", "blocks": ["direction", "payload", "fooling", "ip_id", "rawsend", "reconstruct"],
      "args": [
        { "name": "pos", "kind": "marker", "default": "2" },
        { "name": "nofake1", "kind": "flag" },
        { "name": "nofake2", "kind": "flag" },
        { "name": "nofake3", "kind": "flag" },
        { "name": "nofake4", "kind": "flag" },
        { "name": "pattern", "kind": "blob" },
        { "name": "seqovl", "kind": "int", "min": 1 },
        { "name": "seqovl_pattern", "kind": "blob" },
        { "name": "blob", "kind": "blob" },
        { "name": "optional", "kind": "flag" },
        { "name": "nodrop", "kind": "flag" }
      ],
      "category": "faked", "needs_fooling": true, "ru": "Сплит с фейками вокруг частей", "en": "Split with fakes around the parts" },
    { "name": "fakeddisorder", "file": "zapret-antidpi.lua", "blocks": ["direction", "payload", "fooling", "ip_id", "rawsend", "reconstruct"],
      "args": [
        { "name": "pos", "kind": "marker", "default": "2" },
        { "name": "nofake1", "kind": "flag" },
        { "name": "nofake2", "kind": "flag" },
        { "name": "nofake3", "kind": "flag" },
        { "name": "nofake4", "kind": "flag" },
        { "name": "pattern", "kind": "blob" },
        { "name": "seqovl", "kind": "marker" },
        { "name": "seqovl_pattern", "kind": "blob" },
        { "name": "blob", "kind": "blob" },
        { "name": "optional", "kind": "flag" },
        { "name": "nodrop", "kind": "flag" }
      ],
      "category": "faked", "needs_fooling": true, "ru": "Обратный сплит с фейками", "en": "Reverse split with fakes" },
    { "name": "tcpseg", "file": "zapret-antidpi.lua", "blocks": ["direction", "payload", "fooling", "ip_id", "rawsend", "reconstruct", "ipfrag"],
      "args": [
