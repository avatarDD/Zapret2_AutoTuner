      "category": "obfs", "two_sided": true, "ru": "XOR протокола и данных (нужна вторая сторона)", "en": "XOR protocol and data (needs the other side)" },
    { "name": "udp2icmp", "file": "zapret-obfs.lua", "blocks": [],
      "args": [ { "name": "ctype", "kind": "int" }, { "name": "ccode", "kind": "int" }, { "name": "stype", "kind": "int" }, { "name": "scode", "kind": "int" },
