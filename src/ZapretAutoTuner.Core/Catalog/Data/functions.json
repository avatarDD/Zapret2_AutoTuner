{
  "zapret2_version": "1.0.5.2",
  "lua_compat": 6,
  "lua_init_order": ["zapret-lib.lua", "zapret-antidpi.lua", "zapret-auto.lua", "zapret-obfs.lua", "zapret-pcap.lua"],
  "builtin_blobs": ["fake_default_tls", "fake_default_http", "fake_default_quic"],
  "blocks": {
    "direction": [
      { "name": "dir", "kind": "enum", "values": ["in", "out", "any"], "default": "out" }
    ],
    "payload": [
      { "name": "payload", "kind": "payload_list", "default": "known" }
    ],
    "fooling": [
      { "name": "ip_ttl", "kind": "int", "min": 1, "max": 255 },
      { "name": "ip6_ttl", "kind": "int", "min": 1, "max": 255 },
      { "name": "ip_autottl", "kind": "autottl" },
      { "name": "ip6_autottl", "kind": "autottl" },
      { "name": "ip6_hopbyhop", "kind": "hex_optional" },
      { "name": "ip6_hopbyhop2", "kind": "hex_optional" },
      { "name": "ip6_destopt", "kind": "hex_optional" },
      { "name": "ip6_destopt2", "kind": "hex_optional" },
      { "name": "ip6_routing", "kind": "hex_optional" },
      { "name": "ip6_ah", "kind": "hex_optional" },
      { "name": "tcp_seq", "kind": "int_signed" },
      { "name": "tcp_ack", "kind": "int_signed" },
      { "name": "tcp_ts", "kind": "int_signed" },
      { "name": "tcp_md5", "kind": "hex_optional" },
      { "name": "tcp_flags_set", "kind": "tcp_flags" },
      { "name": "tcp_flags_unset", "kind": "tcp_flags" },
      { "name": "tcp_ts_up", "kind": "flag" },
      { "name": "tcp_nop_del", "kind": "flag" },
      { "name": "fool", "kind": "function" }
    ],
    "reconstruct": [
      { "name": "badsum", "kind": "flag" }
    ],
    "rawsend": [
      { "name": "repeats", "kind": "int", "min": 1, "max": 100 },
      { "name": "ifout", "kind": "string" },
      { "name": "fwmark", "kind": "int" }
    ],
    "ip_id": [
      { "name": "ip_id", "kind": "enum", "values": ["seq", "rnd", "zero", "none"] },
      { "name": "ip_id_conn", "kind": "flag" }
    ],
    "ipfrag": [
      { "name": "ipfrag", "kind": "function_optional" },
      { "name": "ipfrag_disorder", "kind": "flag" },
      { "name": "ipfrag_pos_tcp", "kind": "int", "min": 8, "multiple_of": 8, "default": "32" },
      { "name": "ipfrag_pos_udp", "kind": "int", "min": 8, "multiple_of": 8, "default": "8" },
      { "name": "ipfrag_pos_icmp", "kind": "int", "min": 8, "multiple_of": 8, "default": "8" },
      { "name": "ipfrag_pos", "kind": "int", "min": 8, "multiple_of": 8, "default": "32" },
      { "name": "ipfrag_next", "kind": "int", "min": 0, "max": 255 }
    ]
  },
  "fooling_keys": ["ip_ttl", "ip6_ttl", "ip_autottl", "ip6_autottl", "ip6_hopbyhop", "ip6_hopbyhop2", "ip6_destopt", "ip6_destopt2", "ip6_routing", "ip6_ah", "tcp_seq", "tcp_ack", "tcp_md5", "tcp_flags_set", "tcp_flags_unset", "badsum", "fool"],
  "functions": [
    { "name": "drop", "file": "zapret-antidpi.lua", "blocks": ["direction", "payload"], "args": [],
      "category": "basic", "ru": "Отбросить пакет", "en": "Drop the packet" },
    { "name": "send", "file": "zapret-antidpi.lua", "blocks": ["direction", "fooling", "ip_id", "ipfrag", "rawsend", "reconstruct"],
      "args": [ { "name": "delay", "kind": "int", "min": 0 } ],
      "category": "basic", "ru": "Отправить копию пакета", "en": "Send a copy of the packet" },
    { "name": "pktmod", "file": "zapret-antidpi.lua", "blocks": ["direction", "fooling", "ip_id"], "args": [],
      "category": "basic", "ru": "Применить fooling к самому пакету", "en": "Apply fooling to the packet itself" },
    { "name": "http_domcase", "file": "zapret-antidpi.lua", "blocks": ["direction"], "args": [], "payloads": ["http_req"],
      "category": "http", "ru": "Смешанный регистр домена в Host", "en": "Mixed case of the Host domain" },
    { "name": "http_hostcase", "file": "zapret-antidpi.lua", "blocks": ["direction"],
      "args": [ { "name": "spell", "kind": "string", "length": 4, "default": "host" } ], "payloads": ["http_req"],
      "category": "http", "ru": "Регистр заголовка Host", "en": "Case of the Host header name" },
    { "name": "http_methodeol", "file": "zapret-antidpi.lua", "blocks": ["direction"], "args": [], "payloads": ["http_req"], "last_of_http": true,
      "category": "http", "ru": "Перевод строки перед методом (только nginx)", "en": "Newline before the method (nginx only)" },
    { "name": "http_unixeol", "file": "zapret-antidpi.lua", "blocks": ["direction"], "args": [], "payloads": ["http_req"],
      "category": "http", "ru": "Unix-переводы строк (только nginx)", "en": "Unix line endings (nginx only)" },
    { "name": "synack_split", "file": "zapret-antidpi.lua", "blocks": ["rawsend", "reconstruct", "ipfrag"],
      "args": [ { "name": "mode", "kind": "enum", "values": ["syn", "synack", "acksyn"], "default": "synack" } ],
      "category": "handshake", "server_side": true, "phase0": true, "ru": "Разбить SYN,ACK (серверная техника)", "en": "Split SYN,ACK (server side)" },
    { "name": "synack", "file": "zapret-antidpi.lua", "blocks": ["rawsend", "reconstruct", "ipfrag"], "args": [],
      "category": "handshake", "phase0": true, "breaks_nat": true, "ru": "SYN,ACK перед SYN (ломает NAT)", "en": "SYN,ACK before SYN (breaks NAT)" },
    { "name": "wsize", "file": "zapret-antidpi.lua", "blocks": [],
      "args": [ { "name": "wsize", "kind": "int", "min": 0, "max": 65535 }, { "name": "scale", "kind": "int", "min": 0, "max": 14 } ],
      "category": "window", "phase0": true, "slow": true, "ru": "Окно TCP в SYN,ACK (устарело)", "en": "TCP window in SYN,ACK (legacy)" },
    { "name": "wssize", "file": "zapret-antidpi.lua", "blocks": ["direction"],
      "args": [ { "name": "wsize", "kind": "int", "min": 0, "max": 65535 }, { "name": "scale", "kind": "int", "min": 0, "max": 14 }, { "name": "forced_cutoff", "kind": "payload_list" } ],
      "category": "window", "phase0": true, "slow": true, "ru": "Маленькое окно TCP (последнее средство, режет скорость)", "en": "Small TCP window (last resort, slows down)" },
    { "name": "tls_client_hello_clone", "file": "zapret-antidpi.lua", "blocks": ["direction"],
      "args": [
        { "name": "blob", "kind": "blob_name_out", "required": true },
        { "name": "fallback", "kind": "blob" },
        { "name": "sni_snt", "kind": "int", "min": 0, "max": 255 },
        { "name": "sni_snt_new", "kind": "int", "min": 0, "max": 255 },
        { "name": "sni_del_ext", "kind": "flag" },
        { "name": "sni_del", "kind": "flag" },
        { "name": "sni_first", "kind": "string" },
        { "name": "sni_last", "kind": "string" }
      ], "payloads": ["tls_client_hello"],
      "category": "fake", "ru": "Клон ClientHello в блоб для следующих инстансов", "en": "Clone the ClientHello into a blob for later instances" },
    { "name": "syndata", "file": "zapret-antidpi.lua", "blocks": ["fooling", "rawsend", "reconstruct", "ipfrag"],
      "args": [ { "name": "blob", "kind": "blob" }, { "name": "tls_mod", "kind": "tls_mod", "values": ["rnd", "rndsni", "sni"] } ],
      "category": "handshake", "phase0": true, "ru": "Данные в SYN", "en": "Data in SYN" },
    { "name": "rst", "file": "zapret-antidpi.lua", "blocks": ["direction", "payload", "fooling", "ip_id", "rawsend", "reconstruct", "ipfrag"],
      "args": [ { "name": "rstack", "kind": "flag" } ],
      "category": "fake", "needs_fooling": true, "ru": "Фейковый RST", "en": "Fake RST" },
    { "name": "fake", "file": "zapret-antidpi.lua", "blocks": ["direction", "payload", "fooling", "ip_id", "rawsend", "reconstruct", "ipfrag"],
      "args": [
        { "name": "blob", "kind": "blob", "required": true },
        { "name": "optional", "kind": "flag" },
        { "name": "tls_mod", "kind": "tls_mod", "values": ["rnd", "rndsni", "sni", "dupsid", "padencap"] }
      ],
      "category": "fake", "needs_fooling": true, "ru": "Фейковый пакет перед оригиналом", "en": "Fake packet before the original" },
    { "name": "multisplit", "file": "zapret-antidpi.lua", "blocks": ["direction", "payload", "fooling", "ip_id", "rawsend", "reconstruct", "ipfrag"],
