        { "name": "increment", "kind": "int_signed", "default": "2" },
        { "name": "pattern", "kind": "blob" },
        { "name": "pattern_offset", "kind": "int", "min": 0, "default": "0" }
      ],
      "category": "udp", "ru": "Изменить длину UDP", "en": "Change UDP length" },
