        { "name": "reset", "kind": "flag" },
        { "name": "inseq", "kind": "int", "min": 0, "default": "4096" },
        { "name": "no_http_redirect", "kind": "flag" },
        { "name": "no_rst", "kind": "flag" },
        { "name": "udp_out", "kind": "int", "min": 0, "default": "4" },
        { "name": "udp_in", "kind": "int", "min": 0, "default": "1" }
      ],
      "category": "orchestrator", "orchestrator": true, "needs_incoming": true, "ru": "Ротация стратегий по неудачам", "en": "Rotate strategies on failures" },
