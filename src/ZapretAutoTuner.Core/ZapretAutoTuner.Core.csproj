<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <RootNamespace>ZapretAutoTuner.Core</RootNamespace>
    <IsTrimmable>true</IsTrimmable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Catalog\Data\*.json" LogicalName="ZapretAutoTuner.Core.Catalog.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Packets\Data\*.json" LogicalName="ZapretAutoTuner.Core.Packets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Search\Data\*.yaml" LogicalName="ZapretAutoTuner.Core.Search.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Diagnostics\Data\*.json" LogicalName="ZapretAutoTuner.Core.Diagnostics.%(Filename)%(Extension)" />
    <InternalsVisibleTo Include="ZapretAutoTuner.Core.Tests" />
    <InternalsVisibleTo Include="ZapretAutoTuner.Probes.Tests" />
  </ItemGroup>
</Project>
