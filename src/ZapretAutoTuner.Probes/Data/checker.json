    { "id": "cloudflare", "kind": "provider", "name_ru": "Cloudflare", "name_en": "Cloudflare", "targets": [ { "host": "speed.cloudflare.com", "path": "/__down?bytes=262144", "quic": true } ] },
    { "id": "hetzner", "kind": "provider", "name_ru": "Hetzner", "name_en": "Hetzner", "targets": [ { "host": "fsn1-speed.hetzner.com", "path": "/100MB.bin" } ] },
