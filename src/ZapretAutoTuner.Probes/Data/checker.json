    { "id": "fastly", "kind": "provider", "name_ru": "Fastly", "name_en": "Fastly", "targets": [ { "host": "www.fastly.com" } ] },

    { "id": "yandex", "kind": "control", "name_ru": "Яндекс (контроль)", "name_en": "Yandex (control)", "targets": [ { "host": "ya.ru" } ] },
    { "id": "vk", "kind": "control", "name_ru": "VK (контроль)", "name_en": "VK (control)", "targets": [ { "host": "vk.com" } ] }
  ]
